#!/bin/sh

# ===== ПАРАМЕТР ПОРТА =====
TTY="$1"

if [ -z "$TTY" ]; then
    echo "Использование: transit -ttyUSB3"
    exit 1
fi

# убираем лишнее
TTY="${TTY#-}"
TTY="${TTY#/dev/}"
TTY="/dev/$TTY"

# ===== СЕРВИСЫ КОТОРЫЕ МОЖНО ОСТАНАВЛИВАТЬ =====
SERVICES="
agrosmart_web
agrosmart_sync
agrosmart_mix
persay
"

echo "Остановка сервисов..."

for S in $SERVICES; do
    systemctl stop "$S" 2>/dev/null
done

# ===== УБИВАЕМ СТАРЫЙ MBUSD =====
pkill mbusd 2>/dev/null
sleep 1

echo "Запуск mbusd..."

# ===== ЗАПУСК MBUSD =====
# 115200 8E1 — КРИТИЧНО!
mbusd -p "$TTY" -s 115200 -m 8E1 -t 777 >/dev/null 2>&1 &

sleep 1

# ===== IP =====
IP=$(hostname -I | awk '{print $1}')

echo "Включен транзитный режим RS485 на $TTY"
echo "Доступ по $IP:777"
