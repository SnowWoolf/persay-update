#!/bin/bash

PORT=777
BAUD=115200
MODE="8N1"

RUNDIR="/run/transit"
CFG="/etc/ser2net.yaml"
PIDFILE="$RUNDIR/active"
LOG="/var/log/transit.log"

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$RUNDIR"
touch "$LOG"

usage() {
  echo "Usage:"
  echo "  transit -ttyUSB3"
  echo "  transit -status"
  echo "  transit -stop"
  exit 1
}

get_ip() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}'
  else
    hostname -I | awk '{print $1}'
  fi
}

stop_services() {
  for s in "${SERVICES[@]}"; do
    systemctl stop "$s" 2>/dev/null
  done
}

start_services() {
  for s in "${SERVICES[@]}"; do
    systemctl start "$s" 2>/dev/null
  done
}

start_transit() {
  DEV="$1"

  if [[ -f "$PIDFILE" ]]; then
    echo "Транзит уже активен"
    exit 1
  fi

  stop_services
  systemctl stop ser2net 2>/dev/null

  cat > "$CFG" <<EOF
%YAML 1.1
---

connection: &rs485
  accepter: tcp,$PORT
  connector: serialdev,/dev/$DEV,$BAUD$MODE,local
  options:
    max-connections: 1
    kickolduser: true
    nodelay: true
EOF

  systemctl restart ser2net

  echo "$DEV" > "$PIDFILE"
  echo "$(date) START $DEV" >> "$LOG"

  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV"
  echo "Доступ по $IP:$PORT"
}

stop_transit() {
  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  DEV=$(cat "$PIDFILE")

  systemctl stop ser2net
  rm -f "$PIDFILE"

  start_services

  echo "$(date) STOP $DEV" >> "$LOG"
  echo "Транзит остановлен"
}

status_transit() {
  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  DEV=$(cat "$PIDFILE")
  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP:$PORT"
}

case "$1" in
  -ttyUSB*)
    DEV="${1#-}"
    start_transit "$DEV"
    ;;
  -stop)
    stop_transit
    ;;
  -status)
    status_transit
    ;;
  *)
    usage
    ;;
esac
