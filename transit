#!/bin/bash

LOCKDIR="/var/lock/transit"
RUNDIR="/run/transit"
PORT=777

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$LOCKDIR" "$RUNDIR"

usage() {
  echo "transit -ttyUSBX | -status | -stop"
  exit 1
}

stop_services() {
  echo "Остановка сервисов..."
  for S in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$S.service"; then
      systemctl stop "$S" 2>/dev/null
      systemctl disable "$S" 2>/dev/null
      echo "  stopped $S"
    fi
  done
}

start_services() {
  echo "Запуск сервисов..."
  for S in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$S.service"; then
      systemctl enable "$S" 2>/dev/null
      systemctl start "$S" 2>/dev/null
      echo "  started $S"
    fi
  done
}

if [[ $# -eq 0 ]]; then usage; fi

case "$1" in

  -ttyUSB*)
    DEV="/dev/${1#-}"
    LOCK="$LOCKDIR/${1#-}.lock"
    PIDFILE="$RUNDIR/${1#-}.pid"

    if [[ -f "$PIDFILE" ]]; then
      echo "Транзит уже включен"
      exit 1
    fi

    stop_services

    # Запускаем socat под flock
    flock "$LOCK" \
      socat TCP-LISTEN:$PORT,reuseaddr,fork \
            FILE:$DEV,raw,echo=0,b115200 &

    echo $! > "$PIDFILE"

    IP=$(echo $SSH_CONNECTION | awk '{print $3}')
    echo "Включен транзитный режим RS485 на $DEV"
    echo "Доступ по $IP:$PORT"
    ;;

  -status)
    if ls $RUNDIR/*.pid &>/dev/null; then
      for f in $RUNDIR/*.pid; do
        DEV=$(basename "$f" .pid)
        IP=$(echo $SSH_CONNECTION | awk '{print $3}')
        echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP:$PORT"
      done
    else
      echo "Транзит не активен"
    fi
    ;;

  -stop)
    for f in $RUNDIR/*.pid; do
      kill "$(cat $f)" 2>/dev/null
      rm -f "$f"
    done

    start_services
    echo "Транзит отключен, порт освобожден"
    ;;

  *)
    usage
    ;;
esac
