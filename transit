#!/bin/bash

PORT=777
RUNDIR="/run/transit"
CONF="/tmp/ser2net-transit.yaml"

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$RUNDIR"

usage() {
  echo "Использование:"
  echo "  transit -ttyUSBX   включить транзит"
  echo "  transit -status    статус"
  echo "  transit -stop      выключить транзит"
  exit 1
}

get_ip() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}'
  else
    hostname -I | awk '{print $1}'
  fi
}

stop_services() {
  echo "Остановка сервисов..."
  for s in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$s"; then
      systemctl stop "$s" 2>/dev/null
      systemctl disable "$s" 2>/dev/null
      echo "  stopped $s"
    fi
  done
}

start_services() {
  echo "Запуск сервисов..."
  for s in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$s"; then
      systemctl enable "$s" 2>/dev/null
      systemctl start "$s" 2>/dev/null
      echo "  started $s"
    fi
  done
}

start_transit() {
  DEV="$1"
  PIDFILE="$RUNDIR/transit.pid"

  if [[ -f "$PIDFILE" ]]; then
    echo "Транзит уже включен"
    exit 1
  fi

  stop_services

  cat > "$CONF" <<EOF
connection: &transit
  accepter: tcp,$PORT
  connector: serialdev,$DEV,115200n81,local
EOF

  echo "Запуск ser2net..."
  ser2net -c "$CONF" -d &
  echo $! > "$PIDFILE"

  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на $DEV"
  echo "Доступ по $IP:$PORT"
}

stop_transit() {
  PIDFILE="$RUNDIR/transit.pid"

  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  kill "$(cat $PIDFILE)" 2>/dev/null
  rm -f "$PIDFILE"
  rm -f "$CONF"

  start_services
  echo "Транзит отключен, порт освобожден"
}

status_transit() {
  PIDFILE="$RUNDIR/transit.pid"

  if [[ -f "$PIDFILE" ]]; then
    IP=$(get_ip)
    echo "Включен транзитный режим RS485. Доступ по $IP:$PORT"
  else
    echo "Транзит не активен"
  fi
}

[[ $# -eq 0 ]] && usage

case "$1" in
  -ttyUSB*)
    DEV="/dev/${1#-}"
    start_transit "$DEV"
    ;;
  -status)
    status_transit
    ;;
  -stop)
    stop_transit
    ;;
  *)
    usage
    ;;
esac
