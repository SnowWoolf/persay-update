#!/bin/bash

RUNDIR="/run/transit"
PIDFILE="$RUNDIR/pid"
DEVFILE="$RUNDIR/dev"
LOG="/var/log/transit.log"

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$RUNDIR"
touch "$LOG"

usage() {
  echo "Usage:"
  echo "  transit -ttyUSB3"
  echo "  transit -status"
  echo "  transit -stop"
  exit 1
}

get_ip() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}'
  else
    hostname -I | awk '{print $1}'
  fi
}

stop_services() {
  echo "Остановка сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl stop "$s" 2>/dev/null && echo "  stopped $s"
  done
}

start_services() {
  echo "Запуск сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl start "$s" 2>/dev/null && echo "  started $s"
  done
}

start_transit() {
  DEV="$1"

  if [[ -f "$PIDFILE" ]]; then
    echo "Транзит уже активен"
    exit 1
  fi

  stop_services

  echo "$DEV" > "$DEVFILE"
  echo "$(date) START $DEV" >> "$LOG"

  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV"
  echo "Подключение с клиента:"
  echo "  socat PTY,link=/tmp/ttyV0,raw EXEC:'ssh root@$IP transit-connect'"
}

stop_transit() {
  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  kill "$(cat $PIDFILE)" 2>/dev/null
  rm -f "$PIDFILE" "$DEVFILE"

  start_services
  echo "$(date) STOP" >> "$LOG"
  echo "Транзит остановлен"
}

status_transit() {
  if [[ ! -f "$DEVFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  DEV=$(cat "$DEVFILE")
  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP"
}

connect_mode() {
  if [[ ! -f "$DEVFILE" ]]; then
    echo "Transit not active"
    exit 1
  fi

  DEV=$(cat "$DEVFILE")

  echo $$ > "$PIDFILE"

  # реальный мост байтов
  exec socat - "/dev/$DEV,raw,echo=0"
}

case "$1" in
  -ttyUSB*)
    start_transit "${1#-}"
    ;;
  -stop)
    stop_transit
    ;;
  -status)
    status_transit
    ;;
  transit-connect)
    connect_mode
    ;;
  *)
    usage
    ;;
esac
