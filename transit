#!/bin/bash

PORT=777
TTY="$1"

if [[ -z "$TTY" ]]; then
  echo "Использование: transit -ttyUSB3"
  exit 1
fi

TTY="${TTY#-}"
TTY="${TTY#/dev/}"
TTY="/dev/$TTY"

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

echo "Остановка сервисов..."
for S in "${SERVICES[@]}"; do
  systemctl stop "$S" 2>/dev/null
done

echo "Убиваем старые socat..."
pkill socat 2>/dev/null
sleep 1

echo "Запуск socat..."

socat TCP-LISTEN:$PORT,reuseaddr,fork \
      FILE:$TTY,raw,echo=0,b115200,cs8,parenb,parodd=0,cstopb=0 &

sleep 1

IP=$(hostname -I | awk '{print $1}')

echo "Включен транзитный режим RS485 на $TTY"
echo "Доступ по $IP:$PORT"
