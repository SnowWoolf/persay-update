#!/bin/bash

PORT=777
BAUD=115200
PARITY="none"
STOPBITS=1

RUNDIR="/run/transit"
PIDFILE="$RUNDIR/mbusd.pid"
DEVFILE="$RUNDIR/dev"

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$RUNDIR"

usage() {
  echo "Usage:"
  echo "  transit -ttyUSB3"
  echo "  transit -status"
  echo "  transit -stop"
  exit 1
}

get_ip() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}'
  else
    hostname -I | awk '{print $1}'
  fi
}

stop_services() {
  echo "Остановка сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl stop "$s" 2>/dev/null && echo "  stopped $s"
  done
}

start_services() {
  echo "Запуск сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl start "$s" 2>/dev/null && echo "  started $s"
  done
}

start_transit() {
  DEV="$1"

  if [[ -f "$PIDFILE" ]]; then
    PID=$(cat "$PIDFILE")
    if kill -0 "$PID" 2>/dev/null; then
      echo "Транзит уже активен"
      exit 1
    else
      rm -f "$PIDFILE"
    fi
  fi

  stop_services

  echo "$DEV" > "$DEVFILE"

  echo "Запуск mbusd..."
  mbusd -d /dev/$DEV -b $BAUD -P $PARITY -s $STOPBITS -p $PORT &
  PID=$!
  echo $PID > "$PIDFILE"

  sleep 1

  if ! kill -0 "$PID" 2>/dev/null; then
    echo "Ошибка запуска mbusd"
    rm -f "$PIDFILE"
    exit 1
  fi

  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV"
  echo "Доступ по $IP:$PORT"
}

stop_transit() {
  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  PID=$(cat "$PIDFILE")

  if kill -0 "$PID" 2>/dev/null; then
    kill "$PID"
    echo "mbusd остановлен"
  fi

  rm -f "$PIDFILE" "$DEVFILE"
  start_services
}

status_transit() {
  if [[ ! -f "$PIDFILE" ]]; then
    echo "Транзит не активен"
    exit 0
  fi

  PID=$(cat "$PIDFILE")
  if ! kill -0 "$PID" 2>/dev/null; then
    echo "Транзит не активен"
    exit 0
  fi

  DEV=$(cat "$DEVFILE")
  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP:$PORT"
}

case "$1" in
  -ttyUSB*)
    start_transit "${1#-}"
    ;;
  -stop)
    stop_transit
    ;;
  -status)
    status_transit
    ;;
  *)
    usage
    ;;
esac
