#!/bin/bash

PORT=777
LOCKDIR="/run/transit"
SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$LOCKDIR"

usage() {
  echo "Usage:"
  echo "  transit -ttyUSB3   # включить транзит"
  echo "  transit -status    # статус"
  echo "  transit -stop      # отключить"
  exit 1
}

stop_services() {
  echo "Остановка сервисов..."
  for s in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$s.service"; then
      systemctl stop "$s"
      echo "  stopped $s"
    fi
  done
}

start_services() {
  echo "Запуск сервисов..."
  for s in "${SERVICES[@]}"; do
    if systemctl list-unit-files | grep -q "^$s.service"; then
      systemctl start "$s"
      echo "  started $s"
    fi
  done
}

get_ip() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}'
  else
    hostname -I | awk '{print $1}'
  fi
}

start_transit() {
  DEV="$1"
  PIDFILE="$LOCKDIR/${DEV}.pid"

  if [[ -f "$PIDFILE" ]]; then
    echo "Транзит уже активен для $DEV"
    exit 1
  fi

  stop_services

  echo "Запуск socat..."
  socat TCP-LISTEN:$PORT,reuseaddr,fork FILE:/dev/$DEV,raw,echo=0,b115200 &
  SOCAT_PID=$!
  echo "$SOCAT_PID" > "$PIDFILE"

  IP=$(get_ip)
  echo "Включен транзитный режим RS485 на /dev/$DEV"
  echo "Доступ по $IP:$PORT"
}

stop_transit() {
  FOUND=0
  for f in "$LOCKDIR"/*.pid; do
    [[ -e "$f" ]] || continue
    PID=$(cat "$f")
    kill "$PID" 2>/dev/null
    rm -f "$f"
    FOUND=1
  done

  if [[ $FOUND -eq 0 ]]; then
    echo "Активных транзитов нет"
  else
    echo "Транзит остановлен"
  fi

  start_services
}

status_transit() {
  FOUND=0
  for f in "$LOCKDIR"/*.pid; do
    [[ -e "$f" ]] || continue
    DEV=$(basename "$f" .pid)
    IP=$(get_ip)
    echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP:$PORT"
    FOUND=1
  done

  if [[ $FOUND -eq 0 ]]; then
    echo "Транзит не активен"
  fi
}

# ---- MAIN ----

if [[ $# -eq 0 ]]; then
  usage
fi

case "$1" in
  -ttyUSB*)
    DEV="${1#-}"
    start_transit "$DEV"
    ;;
  -stop)
    stop_transit
    ;;
  -status)
    status_transit
    ;;
  *)
    usage
    ;;
esac
