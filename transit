#!/bin/bash

STATE_FILE="/var/run/transit.state"
PORT=777

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

get_ip() {
  who | awk '{print $5}' | sed 's/[()]//g' | head -n1
}

stop_services() {
  echo "Остановка сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl stop "$s" 2>/dev/null && echo "  stopped $s"
  done
}

start_services() {
  echo "Запуск сервисов..."
  for s in "${SERVICES[@]}"; do
    systemctl start "$s" 2>/dev/null && echo "  started $s"
  done
}

start_mbusd() {
  DEV="$1"

  # убиваем старый если висит
  pkill mbusd 2>/dev/null

  mbusd -p "$DEV" -s 115200 -t $PORT >/dev/null 2>&1 &
  sleep 1
}

stop_mbusd() {
  pkill mbusd 2>/dev/null
}

is_mbusd_running() {
  pgrep mbusd >/dev/null 2>&1
}

case "$1" in

  -ttyUSB*)
    DEV="/dev/${1#-}"

    if [ ! -e "$DEV" ]; then
      echo "Устройство $DEV не найдено"
      exit 1
    fi

    stop_services
    start_mbusd "$DEV"

    if is_mbusd_running; then
      echo "$DEV" > "$STATE_FILE"
      IP=$(get_ip)
      echo "Включен транзитный режим RS485 на $DEV"
      echo "Доступ по $IP:$PORT"
    else
      echo "Ошибка запуска mbusd"
      exit 1
    fi
    ;;

  -status)
    if [ -f "$STATE_FILE" ] && is_mbusd_running; then
      DEV=$(cat "$STATE_FILE")
      IP=$(get_ip)
      echo "Включен транзитный режим RS485 на $DEV. Доступ по $IP:$PORT"
    else
      echo "Транзит не активен"
    fi
    ;;

  -stop)
    if is_mbusd_running; then
      stop_mbusd
      rm -f "$STATE_FILE"
      start_services
      echo "Транзит отключен"
    else
      echo "Транзит не активен"
    fi
    ;;

  *)
    echo "Использование:"
    echo "  transit -ttyUSB3   включить транзит"
    echo "  transit -status    статус"
    echo "  transit -stop      выключить транзит"
    ;;

esac
