#!/bin/bash

LOCKDIR="/var/lock/transit"
RUNDIR="/run/transit"
PORT=777

mkdir -p "$LOCKDIR" "$RUNDIR"

usage() {
  echo "transit -ttyUSBX | -status | -stop"
  exit 1
}

if [[ $# -eq 0 ]]; then usage; fi

case "$1" in

  -ttyUSB*)
    DEV="/dev/${1#-}"
    LOCK="$LOCKDIR/${1#-}.lock"
    PIDFILE="$RUNDIR/${1#-}.pid"

    if [[ -f "$PIDFILE" ]]; then
      echo "Транзит уже включен"
      exit 1
    fi

    # Останавливаем основной сервис
    systemctl stop agrosmart_web
    systemctl stop agrosmart_sync
    systemctl stop agrosmart_mix
    systemctl stop persay

    # Запускаем socat под flock
    flock "$LOCK" \
      socat TCP-LISTEN:$PORT,reuseaddr,fork \
            FILE:$DEV,raw,echo=0,b115200 &
    
    echo $! > "$PIDFILE"

    IP=$(echo $SSH_CONNECTION | awk '{print $3}')
    echo "Включен транзитный режим RS485 на //$DEV"
    echo "Доступ по $IP:$PORT"
    ;;

  -status)
    if ls $RUNDIR/*.pid &>/dev/null; then
      for f in $RUNDIR/*.pid; do
        DEV=$(basename "$f" .pid)
        IP=$(echo $SSH_CONNECTION | awk '{print $3}')
        echo "Включен транзитный режим RS485 на //$DEV. Доступ по $IP:$PORT"
      done
    else
      echo "Транзит не активен"
    fi
    ;;

  -stop)
    for f in $RUNDIR/*.pid; do
      kill "$(cat $f)" 2>/dev/null
      rm -f "$f"
    done

    systemctl start agrosmart_web
    systemctl start agrosmart_sync
    systemctl start agrosmart_mix
    systemctl start persay
    echo "Транзит отключен, порт освобожден"
    ;;

  *)
    usage
    ;;
esac
