#!/bin/bash

LOCKDIR="/var/lock/transit"
RUNDIR="/run/transit"
PORT=777

SERVICES=(
  agrosmart_web
  agrosmart_sync
  agrosmart_mix
  persay
)

mkdir -p "$LOCKDIR" "$RUNDIR"

usage() {
  echo "transit -ttyUSBX | -status | -stop"
  exit 1
}

[[ $# -eq 0 ]] && usage

case "$1" in

  -ttyUSB*)
    DEV="/dev/${1#-}"
    NAME="${1#-}"
    LOCK="$LOCKDIR/$NAME.lock"
    PIDFILE="$RUNDIR/$NAME.pid"

    [[ -f "$PIDFILE" ]] && { echo "Транзит уже включен"; exit 1; }

    echo "Остановка сервисов..."
    for S in "${SERVICES[@]}"; do
      systemctl stop "$S" 2>/dev/null
      systemctl mask "$S" 2>/dev/null
    done

    echo "Запуск socat..."

    flock "$LOCK" socat \
      TCP-LISTEN:$PORT,reuseaddr,fork \
      FILE:$DEV,raw,echo=0,b115200,cs8,parenb=0,cstopb=0,ixon=0,ixoff=0,crtscts=0 \
      &

    echo $! > "$PIDFILE"

    IP=$(echo $SSH_CONNECTION | awk '{print $3}')
    echo "Включен транзитный режим RS485 на $DEV"
    echo "Доступ по $IP:$PORT"
    ;;

  -status)
    if ls $RUNDIR/*.pid &>/dev/null; then
      for f in $RUNDIR/*.pid; do
        DEV=$(basename "$f" .pid)
        IP=$(echo $SSH_CONNECTION | awk '{print $3}')
        echo "Включен транзитный режим RS485 на /dev/$DEV. Доступ по $IP:$PORT"
      done
    else
      echo "Транзит не активен"
    fi
    ;;

  -stop)
    for f in $RUNDIR/*.pid; do
      kill "$(cat $f)" 2>/dev/null
      rm -f "$f"
    done

    for S in "${SERVICES[@]}"; do
      systemctl unmask "$S" 2>/dev/null
      systemctl start "$S" 2>/dev/null
    done

    echo "Транзит отключен, порт освобожден"
    ;;

  *)
    usage
    ;;
esac
