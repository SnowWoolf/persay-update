#!/bin/bash
set -e

APP_DIR="/home/persay"
CONFIG_FILE="$APP_DIR/config.yaml"
DATA_FILE="$APP_DIR/data/data.db"
BACKUP_DIR="/home/persay/.andromeda_backups"
TS=$(date +"%Y-%m-%d_%H-%M-%S")

cd "$APP_DIR"

echo "[INFO] Остановка Andromeda"
systemctl stop andromeda

if [ -f "$CONFIG_FILE" ]; then
  echo "[INFO] Резервное копирование config.yaml"
  mkdir -p "$BACKUP_DIR"
  cp "$CONFIG_FILE" "$BACKUP_DIR/config_$TS.yaml"
else
  echo "[WARN] config.yaml не найден, пропускаем бэкап"
fi

echo "[INFO] Временное удаление локального конфига и базы данных"

if [ -f "$CONFIG_FILE" ]; then
  mv "$CONFIG_FILE" /tmp/andromeda_config.yaml
fi

if [ -f "$DATA_FILE" ]; then
  mv "$DATA_FILE" /tmp/andromeda_data.db
fi

echo "[INFO] Обновление кода из Git"
git fetch origin
git reset --hard origin/master

echo "[INFO] Восстановление локального конфига и базы данных"

if [ -f /tmp/andromeda_config.yaml ]; then
  mv /tmp/andromeda_config.yaml "$CONFIG_FILE"
fi

if [ -f /tmp/andromeda_data.db ]; then
  mv /tmp/andromeda_data.db "$DATA_FILE"
fi

echo "[INFO] Обновление Python-зависимостей"
"$APP_DIR/venv/bin/pip" install -r requirements.txt

echo "[INFO] Очистка резервных копий старше 30 дней"
find "$BACKUP_DIR" -type f -mtime +30 -delete || true

echo "[INFO] Запуск Andromeda"
systemctl start andromeda

echo "[OK] Обновление завершено успешно"
